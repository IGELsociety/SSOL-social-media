# Copy to .env and fill in. Never commit the real .env.

# --- Bluesky ---
# Use an APP PASSWORD (Settings -> Privacy and security -> App passwords),
# not the account password.
BLUESKY_HANDLE=igelsociety.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Mastodon ---
# Preferences -> Development -> New application, scope: write:statuses
MASTODON_API_BASE=https://mastodon.social
MASTODON_TOKEN=

# --- Landing page the "View publication" card points at ---
LANDING_URL=https://igelsociety.org/ssol-archive/

# --- Optional ---
ZOTERO_GROUP_ID=6608170
CARD_CTA=View publication
CARD_THUMB_URL=https://igelsociety.org/images/logo.png
# MASTODON_VISIBILITY=public
# DRY_RUN=true
